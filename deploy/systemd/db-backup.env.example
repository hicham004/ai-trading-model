# /etc/ai-trading/db-backup.env - the ONLY environment of db-backup.service (owner root, mode 600).
# See docs/runbooks/DB_MIGRATIONS.md, step 1. Never put OKX keys here, and never point the
# service at the repository .env (it holds the OKX demo keys).

# The PostgreSQL connection the shadow run uses: the DATABASE_URL line of the checkout's .env,
# copied with the runbook's command (never typed by hand, never echoed in a shell, a chat or a
# screenshot). The script accepts the application's form (postgresql+psycopg://user:pw@host:port/db)
# and moves the password into PGPASSWORD for pg_dump, so it never appears on a command line.
# This is the only secret in this file.
DATABASE_URL=

# Where the dumps go. The unit creates /var/lib/ai-trading/db-backups for the service user
# (StateDirectory); if you change it, add the new folder to ReadWritePaths in db-backup.service.
#DB_BACKUP_DIR=/var/lib/ai-trading/db-backups

# Remove dumps older than this many days (default 14; 0 never removes) ...
#DB_BACKUP_RETENTION_DAYS=14
# ... but never the newest N dumps, whatever their age (default 7).
#DB_BACKUP_KEEP_MIN=7

# Refuse to start a dump with less free space than this in the backup folder (MB, default 500).
#DB_BACKUP_MIN_FREE_MB=500
