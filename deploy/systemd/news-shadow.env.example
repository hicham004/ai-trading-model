# /etc/ai-trading/news-shadow.env - the news shadow's ONLY environment (owner root, mode 600).
# See docs/runbooks/NEWS_SHADOW.md. Never put OKX keys here, and never point the
# service at the repository .env (it holds the OKX demo keys).

# The Anthropic API key of a dedicated workspace that has a monthly spend limit
# (runbook step 1). Paste it with `sudoedit`; never echo it in a shell, a chat or a screenshot.
ANTHROPIC_API_KEY=

# Software spend cap in US dollars per calendar month (default 40). Keep it below
# the console limit so the software cap is reached first.
NEWS_SHADOW_MONTHLY_CAP_USD=40

# Pacing: one day may use at most this many times its even share of what is left
# this month (default 2; 0 turns pacing off).
NEWS_SHADOW_DAILY_PACE=2

# Optional: the Phase 6a journal directory, read-only (default logs/shadow).
#PHASE6A_JOURNAL_DIR=/path/to/ai-trading-model/logs/shadow

# Optional: NEWS_SHADOW_LOG_LEVEL=INFO
