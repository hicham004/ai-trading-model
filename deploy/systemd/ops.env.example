# /etc/ai-trading/ops.env - the ONLY environment of ops-digest.service and okx-changelog-watch.service
# (owner root, mode 600). See docs/runbooks/OPS_DIGEST.md. Never put OKX keys here, and never point
# the services at the repository .env (it holds the OKX demo keys).

# The Telegram bot that sends the digest and the changelog alerts (the shadow's bot is fine).
# Rotate the token in BotFather first if it was ever shown on a screen (CLAUDE.md, open item 8).
# Paste the values with `sudoedit`; never echo them in a shell, a chat or a screenshot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = format the messages but never send them (for a first test); 0 = send.
TELEGRAM_DRY_RUN=0

# Optional: a short Claude summary on top of the digest. Leave empty to send the template only.
# Use a separate key from the capped workspace of the news shadow (docs/runbooks/NEWS_SHADOW.md, step 1).
ANTHROPIC_API_KEY=
# Software cap of the summary in US dollars per calendar month (default 3; one summary costs a few cents).
OPS_DIGEST_AI_MONTHLY_CAP_USD=3

# Optional: where the services' files are (defaults inside the checkout: logs/shadow,
# logs/news_shadow, logs/paper_fleet, logs/ops). If you change OPS_DIR, change ReadWritePaths in both units.
#PHASE6A_JOURNAL_DIR=/path/to/ai-trading-model/logs/shadow
#NEWS_SHADOW_LOG_DIR=/path/to/ai-trading-model/logs/news_shadow
#PAPER_FLEET_DIR=/path/to/ai-trading-model/logs/paper_fleet
#OPS_DIR=/path/to/ai-trading-model/logs/ops
# The news shadow's monthly cap, only for the digest's "of the $40 cap" line (default 40).
#NEWS_SHADOW_MONTHLY_CAP_USD=40
