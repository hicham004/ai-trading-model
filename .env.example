# Example configuration for PUBLIC market-data research and observation.
#
# Copy this file to ".env" and adjust values if needed:
#     cp .env.example .env
#
# This file contains NO secrets and must never contain real credentials,
# API keys, or account tokens. Current phases use public market data only.

# Public OKX REST base URL (public market-data endpoints only).
OKX_PUBLIC_API_BASE_URL=https://www.okx.com
OKX_REQUEST_TIMEOUT=10
OKX_MAX_RETRIES=3

APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL from docker-compose.yml. The password here is a LOCAL-ONLY,
# non-secret development default and must never be reused elsewhere.
DATABASE_URL=postgresql+psycopg://trading:trading_local_dev@localhost:5432/trading

# Easy local alternative that needs no Docker (uncomment to use SQLite):
# DATABASE_URL=sqlite:///data/research.db

# Phase 1 safety lock. Keep this false. There is no live execution path.
LIVE_TRADING_ENABLED=false

# --- Phase 3A: live PUBLIC market-data observation (no trading) ----------
# Public, UNAUTHENTICATED OKX market-data WebSocket URLs. Market-data only;
# they never carry credentials. Only these approved public/business paths are
# accepted on the production path.
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_BUSINESS_WS_URL=wss://ws.okx.com:8443/ws/v5/business

# When true, the FastAPI app opens the public stream in-process on startup so
# the read-only /live endpoints show live data. Default false so imports and
# tests never open a WebSocket.
LIVE_WS_AUTOSTART=false

# Seconds without a valid, accepted market-data update before a feed is
# reported stale. Must be a positive, finite number.
LIVE_STALE_AFTER_SECONDS=30
