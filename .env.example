# Example configuration for PUBLIC market-data research and observation.
#
# Copy this file to ".env" and adjust values if needed:
#     cp .env.example .env
#
# This file contains NO secrets and must never contain real credentials,
# API keys, or account tokens. Current phases use public market data only.

# Public OKX REST base URL (public market-data endpoints only).
OKX_PUBLIC_API_BASE_URL=https://www.okx.com
OKX_REQUEST_TIMEOUT=10
OKX_MAX_RETRIES=3

APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL from docker-compose.yml. The password here is a LOCAL-ONLY,
# non-secret development default and must never be reused elsewhere.
DATABASE_URL=postgresql+psycopg://trading:trading_local_dev@localhost:5432/trading

# Easy local alternative that needs no Docker (uncomment to use SQLite):
# DATABASE_URL=sqlite:///data/research.db

# Hard safety lock. Keep this false. There is no live execution path.
LIVE_TRADING_ENABLED=false

# --- Phase 3A: live PUBLIC market-data observation (no trading) ----------
# Public, UNAUTHENTICATED OKX market-data WebSocket URLs. Market-data only;
# they never carry credentials. Only these approved public/business paths are
# accepted on the production path.
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_BUSINESS_WS_URL=wss://ws.okx.com:8443/ws/v5/business

# When true, the FastAPI app opens the public stream in-process on startup so
# the read-only /live endpoints show live data. Default false so imports and
# tests never open a WebSocket.
LIVE_WS_AUTOSTART=false

# Seconds without a valid, accepted market-data update before a feed is
# reported stale. Must be a positive, finite number.
LIVE_STALE_AFTER_SECONDS=30

# --- Phase 3B: optional durable PUBLIC market-data persistence -----------
# Disabled by default. When enabled, confirmed candles and sampled,
# sequence-validated public order books are written to DATABASE_URL.
LIVE_PERSISTENCE_ENABLED=false
LIVE_PERSISTENCE_POLL_SECONDS=1
LIVE_ORDER_BOOK_SNAPSHOT_SECONDS=5
LIVE_ORDER_BOOK_DEPTH=20
LIVE_ORDER_BOOK_RETENTION=10000

# Maximum confirmed 1m candles fetched from the public history endpoint to
# repair one detected live-candle gap. OKX caps one response at 300.
LIVE_BACKFILL_MAX_BARS=300

# --- Phase 4: local paper trading (SIMULATION ONLY) -----------------------
# These values control virtual local state only. They contain no credentials
# and cannot enable OKX demo or real order access.
PAPER_ACCOUNT_NAME=default
PAPER_STRATEGY=ma_crossover
PAPER_INSTRUMENTS=BTC-USDT
PAPER_TIMEFRAME=1m
PAPER_STARTING_CASH=10000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_RATE=0.0005
PAPER_MIN_CONFIDENCE=0.60
PAPER_MAX_RISK_PER_TRADE=0.01
PAPER_MAX_POSITION_SIZE=0.25
PAPER_MAX_TOTAL_EXPOSURE=0.50
PAPER_MAX_DAILY_LOSS=0.05
PAPER_MAX_OPEN_POSITIONS=1
PAPER_MAX_QUOTE_AGE_SECONDS=10
PAPER_MAX_CANDLE_AGE_SECONDS=180
PAPER_POLL_SECONDS=1
PAPER_WINDOW_SIZE=300
PAPER_LOCK_STALE_SECONDS=60

# --- Phase 5: authenticated OKX DEMO (simulated) trading -----------------
# SECURITY: DEMO/SIMULATED ONLY. Every request sends x-simulated-trading: 1 to
# a strict hostname allowlist; there is no production path. Demo trading is
# WIP and NOT accepted. Never place real orders; never use production keys.
#
# Demo API credentials are read ONLY from these environment variables and are
# NEVER stored in the database, logs, API responses, or this file. Create them
# in OKX Demo Trading -> Personal Center -> Demo Trading API. Leave them UNSET
# unless you are deliberately running an armed demo session. Do NOT commit real
# values here; .env.example is documentation only.
# OKX_DEMO_API_KEY=
# OKX_DEMO_API_SECRET=
# OKX_DEMO_API_PASSPHRASE=

# Non-secret demo configuration (safe defaults shown).
OKX_DEMO_REST_BASE_URL=https://www.okx.com
OKX_DEMO_PRIVATE_WS_URL=wss://wspap.okx.com:8443/ws/v5/private
DEMO_ACCOUNT_NAME=demo
DEMO_STRATEGY=ma_crossover
DEMO_INSTRUMENTS=BTC-USDT
DEMO_TIMEFRAME=1m
DEMO_MAX_ORDER_NOTIONAL=100
DEMO_MAX_RISK_PER_TRADE=0.01
DEMO_MAX_POSITION_SIZE=0.10
DEMO_MAX_TOTAL_EXPOSURE=0.25
DEMO_MAX_DAILY_LOSS=0.05
DEMO_MAX_OPEN_POSITIONS=1
DEMO_ARM_TTL_SECONDS=900

# The optional demo smoke test ALSO requires this opt-in, plus a CLI flag and
# valid demo credentials. It stays off for imports, the API, and tests.
OKX_DEMO_SMOKE_TEST=false
