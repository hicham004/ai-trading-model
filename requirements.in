# Direct dependencies (hand-maintained, pinned for reproducibility).
#
# This is the SOURCE file. `requirements.txt` is GENERATED from it with every
# transitive dependency pinned and hashed. Do not edit requirements.txt by hand.
#
# To change a dependency: edit this file, then regenerate the lockfile:
#
#   uv pip compile requirements.in --universal --generate-hashes \
#       --python-version 3.11 -o requirements.txt
#
# Public market data, local storage, API, dashboard, migrations, and tests
# only. No dependency here reaches a production trading endpoint.

# Web API
fastapi==0.136.0
starlette==1.3.1
uvicorn[standard]==0.34.0

# Database
SQLAlchemy==2.0.36
